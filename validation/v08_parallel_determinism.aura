;; V8 parallel candidate scoring is deterministic and actually parallel (aura/search.aura
;; scores a wave of candidates in fibers; the result must not depend on wave width).
(define (score c)  ; pure CPU-bound scoring of a candidate threshold vector
  (let loop ((i 0) (acc 0))
    (if (>= i 20000) (+ acc c) (loop (+ i 1) (modulo (+ (* acc 31) (* i c) 7) 1000003)))))
(define CANDS (range 32))
(define (run-waves width)
  (let ((ch (channel:create 64)) (out (hash)))
    (let wave ((rest CANDS))
      (if (null? rest) out
          (let* ((w (let take ((xs rest) (n width) (acc (list))) (if (or (null? xs) (= n 0)) (reverse acc) (take (cdr xs) (- n 1) (cons (car xs) acc)))))
                 (fs (map (lambda (c) (spawn-reporting ch (str c) (lambda () (format "~a|~a" c (score c))))) w))
                 (rs (map (lambda (f) (channel:recv ch)) fs)))
            (for-each fiber:join fs)
            (for-each (lambda (r) (let ((p (split-on r "|"))) (hash-set! out (car p) (cadr p)))) rs)
            (wave (list-tail rest (length w))))))))
(define (canon h) (map (lambda (c) (hg h (str c) "missing")) CANDS))
(define times (hash))
(define results (map (lambda (w) (let* ((t (monotonic-ms)) (r (canon (run-waves w)))) (hash-set! times w (- (monotonic-ms) t)) r)) (list 1 2 4 8)))
(define serial (map (lambda (c) (str (score c))) CANDS))
(check! "par.identical-across-widths" (all? (lambda (r) (list=? r serial)) results)
        (format "mismatches per width 1/2/4/8: ~a; first bad (cand got want): ~a" (map (lambda (r) (count-if (lambda (i) (not (equal? (list-ref r i) (list-ref serial i)))) (range 32))) results)
                (let find ((rs results)) (if (null? rs) "-" (let ((bad (filter (lambda (i) (not (equal? (list-ref (car rs) i) (list-ref serial i)))) (range 32))))
                                                             (if (null? bad) (find (cdr rs)) (list (car bad) (list-ref (car rs) (car bad)) (list-ref serial (car bad)))))))))
(for-each (lambda (w) (bench! (format "par.32-cands-width-~a-ms" w) (hash-ref times w) "ms")) (list 1 2 4 8))
(define sp (r3 (/ (* 1.0 (hash-ref times 1)) (max 1 (hash-ref times 8)))))
(bench! "par.speedup-8-vs-1" sp "x")
(info! "par.note" "box has 8 cores shared with other workers; speedup is indicative only")
(check! "par.some-parallel-speedup" (> sp 1.3) (format "width 8 only ~ax faster than width 1" sp))
;; 8.2 #4745: closures created inside fibers capture their own k
(define cc (channel:create 16))
(define cfs (map (lambda (k) (spawn-reporting cc (str k) (lambda () (let ((f (lambda (x) (+ x k)))) (fiber:yield) (str (f 1000)))))) (range 8)))
(define couts (map (lambda (f) (channel:recv cc)) cfs))
(for-each fiber:join cfs)
(check! "par.fiber-closures-capture-4745" (equal? (sorted-strs couts) (sorted-strs (map (lambda (k) (str (+ 1000 k))) (range 8)))) (format "~a" couts))
(emit "done" "ok")
