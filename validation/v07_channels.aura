;; V7 channels (aura/search.aura: RCH = channel:create 256, one result per candidate fiber).
;; 7.1 8 producers x 500 into a capacity-16 channel: blocking send applies backpressure,
;; nothing is lost or duplicated, per-producer order is kept
(define P 8) (define M 500)
(define ch (channel:create 16))
(define acks (channel:create 16))
(define t0 (monotonic-ms))
(define fs (map (lambda (k) (spawn-reporting acks (str k) (lambda () (for-each (lambda (i) (channel:send ch (format "~a|~a" k i))) (range M)) "sent"))) (range P)))
(define got (map (lambda (i) (channel:recv ch)) (range (* P M))))
(define ack-list (map (lambda (f) (channel:recv acks)) fs))
(for-each fiber:join fs)
(define ms (- (monotonic-ms) t0))
(define (seq-of k) (map (lambda (p) (string->number (cadr (split-on p "|")))) (filter (lambda (p) (string=? (car (split-on p "|")) (str k))) got)))
(check! "chan.8x500-cap16-no-loss" (and (all? (lambda (a) (equal? a "sent")) ack-list) (= (length got) (* P M)) (= (distinct-count got) (* P M)))
        (format "acks=~a got=~a distinct=~a" ack-list (length got) (distinct-count got)))
(check! "chan.per-producer-fifo" (all? (lambda (k) (list=? (seq-of k) (range M))) (range P)) "reordered")
(bench! "chan.mpsc-throughput" (r3 (/ (* P M 1.0) (max ms 1))) "msgs/ms")
;; 7.2 structured payloads (#4763): lists and nested hashes survive a fiber hop
(define sc (channel:create 4))
(define sf (spawn-reporting sc "s" (lambda () (list 1 "two" (hash "k" (list 3 4)) (vector 5 6)))))
(define v (channel:recv sc)) (fiber:join sf)
(check! "chan.structured-payload-4763"
        (and (pair? v) (equal? (car v) 1) (equal? (cadr v) "two") (equal? (hash-ref (caddr v) "k") (list 3 4)) (equal? (vector-ref (list-ref v 3) 1) 6))
        (format "~a" v))
;; closures are not a supported payload: the send must fail loudly (and the sender can catch it)
(define cf (spawn-reporting sc "c" (lambda () (list "fn" (lambda (x) x)))))
(define cv (channel:recv sc)) (fiber:join cf)
(check! "chan.closure-payload-rejected-loudly" (and (string? cv) (string-contains? cv "unsupported payload")) (format "~a" cv))
;; 7.3 try-recv on an empty channel does not block and is distinguishable from a value
(define ec (channel:create 2))
(define tr (channel:try-recv ec))
(info! "chan.try-recv-empty-returns" (format "~s" tr))
(channel:send ec #f)
(define tr2 (channel:try-recv ec))
(info! "chan.try-recv-of-#f-returns" (format "~s" tr2))
(check! "chan.try-recv-empty-vs-#f-distinguishable" (not (equal? (str tr) (str tr2))) (format "empty=~s value-#f=~s look the same" tr tr2))
(channel:send ec "")
(define tr3 (channel:try-recv ec))
(info! "chan.try-recv-empty-vs-empty-string" (if (equal? tr3 tr) "ambiguous: an empty channel and a queued \"\" both return \"\"" "distinguishable"))
;; 7.4 unbuffered-ish ping-pong latency (capacity 1)
(define a (channel:create 1)) (define b (channel:create 1))
(define N 2000)
(define pf (fiber:spawn (lambda () (for-each (lambda (i) (channel:send b (+ 1 (channel:recv a)))) (range N)) 'done)))
(define tp (monotonic-ms))
(define okpp (all? (lambda (i) (begin (channel:send a i) (= (channel:recv b) (+ i 1)))) (range N)))
(define pms (- (monotonic-ms) tp))
(fiber:join pf)
(check! "chan.ping-pong-correct" okpp "wrong reply")
(bench! "chan.ping-pong-rtt-us" (r3 (/ (* 1000.0 pms) N)) "us/round-trip")
(emit "done" "ok")
