;; V5 hot rebind while worker fibers keep calling the policy (the search coordinator rebinds
;; between waves; this pushes it further: rebinds land while fibers are mid-call).
;; Claim: every call answers with v1 or v2 semantics, never an error, never a half-state.
(set-code "(define (expedite? risk) (> risk 50))\n(define (respond risk) (if (expedite? risk) \"expedite\" \"wait\"))\n")
(eval-current)
(define V1 "(define (expedite? risk) (> risk 50))")
(define V2 "(define (expedite? risk) (> risk 20))")
(define F 4) (define CALLS 3000)
(define ch (channel:create 16))
(define STOP (atomic:counter 0))
(define (worker k)
  (spawn-reporting ch (str k)
    (lambda ()
      (let loop ((i 0) (e 0) (x 0) (other 0))
        (if (>= i CALLS) (format "~a|~a|~a" e x other)
            (let ((r (try (respond 30) (catch (ex) 'err))))
              (cond ((equal? r "expedite") (loop (+ i 1) e (+ x 1) other))
                    ((equal? r "wait") (loop (+ i 1) (+ e 1) x other))
                    (else (loop (+ i 1) e x (+ other 1))))))))))
(define t0 (monotonic-ms))
(define fs (map worker (range F)))
(define rebinds 0) (define rebind-errors 0)
(let loop ((k 0))
  (if (< k 60)
      (let ((r (try (mutate:rebind "expedite?" (if (= (modulo k 2) 0) V2 V1) (format "flip ~a" k)) (catch (e) 'err))))
        (try (eval-current) (catch (e) #f))
        (if (eq? r #t) (set! rebinds (+ rebinds 1)) (set! rebind-errors (+ rebind-errors 1)))
        (fiber:yield)
        (loop (+ k 1)))
      #t))
(define outs (map (lambda (f) (channel:recv ch)) fs))
(for-each (lambda (f) (try (fiber:join f) (catch (e) #f))) fs)
(define ms (- (monotonic-ms) t0))
(define parsed (map (lambda (o) (if (string-prefix? o "ERR") (list -1 -1 -1) (map string->number (split-on o "|")))) outs))
(define total-wait (foldl + 0 (map car parsed)))
(define total-exp (foldl + 0 (map cadr parsed)))
(define total-other (foldl + 0 (map caddr parsed)))
(info! "rebindconc.outcomes" (format "fibers=~a wait(v1)=~a expedite(v2)=~a other=~a rebinds=~a rebind-errors=~a ms=~a raw=~a" F total-wait total-exp total-other rebinds rebind-errors ms outs))
(check! "rebindconc.no-errors-or-torn-results" (and (all? (lambda (o) (not (string-prefix? o "ERR"))) outs) (= total-other 0) (= (+ total-wait total-exp) (* F CALLS)))
        (format "outs=~a" outs))
(check! "rebindconc.all-rebinds-accepted" (and (= rebinds 60) (= rebind-errors 0)) (format "ok=~a err=~a" rebinds rebind-errors))
(mutate:rebind "expedite?" V2 "final") (eval-current)
(check! "rebindconc.final-state-v2" (equal? (respond 30) "expedite") (respond 30))
(bench! "rebindconc.calls-per-ms" (r3 (/ (* F CALLS 1.0) (max ms 1))) "calls/ms")
(emit "done" "ok")
