;; V6 per-fiber COW overlays (fiber:overlay-*), as aura/search.aura evaluates every swarm
;; candidate privately (begin -> define slot -> get -> rollback, never committed).
(define X 100)
(define res (channel:create 64))
;; 6.1 isolation: 8 fibers each define a private slot and a private X; nobody sees anybody else
(define (iso k)
  (spawn-reporting res (str k)
    (lambda ()
      (fiber:overlay-begin)
      (fiber:overlay-define "cand" (* k 11))
      (fiber:overlay-define "X" k)
      (fiber:yield)
      (let* ((mine (fiber:overlay-get "cand" #f)) (x (fiber:overlay-get "X" #f)) (pend (fiber:overlay-pending)))
        (fiber:overlay-rollback)
        (let ((after (fiber:overlay-get "cand" 'gone)))
          (format "~a|~a|~a|~a|~a" k mine x (if (pair? pend) (length pend) pend) after))))))
(define fs (map iso (range 8)))
(define outs (map (lambda (f) (channel:recv res)) fs))
(for-each fiber:join fs)
(define (iso-ok o) (let ((p (split-on o "|"))) (let ((k (string->number (car p))))
                     (and (equal? (cadr p) (str (* k 11))) (equal? (caddr p) (str k)) (equal? (list-ref p 4) "gone")))))
(check! "overlay.isolation-8-fibers" (all? iso-ok outs) (format "~a" outs))
(check! "overlay.main-unchanged" (= X 100) (format "X=~a" X))
(info! "overlay.pending-shape" (list-ref (split-on (car outs) "|") 3))
;; 6.2 deterministic write-write conflict: both fibers stage Y, A commits first, then B
(define Y 0)
(define ready (channel:create 4)) (define done (channel:create 4))
(define goA (channel:create 1)) (define goB (channel:create 1))
(define (stager v go)
  (spawn-reporting done (str v)
    (lambda () (fiber:overlay-begin) (fiber:overlay-define "Y" v) (channel:send ready v) (channel:recv go)
      (let ((c (try (fiber:overlay-commit) (catch (e) (format "raised:~a" e))))) (if (eq? c #t) "committed" (str c))))))
(define fa (stager 1 goA)) (define fb (stager 2 goB))
(channel:recv ready) (channel:recv ready)
(channel:send goA "go") (define ra (channel:recv done))
(channel:send goB "go") (define rbb (channel:recv done))
(fiber:join fa) (fiber:join fb)
(info! "overlay.conflict-loser" rbb)
(check! "overlay.first-committer-wins" (and (equal? ra "committed") (= Y 1)) (format "A=~a Y=~a" ra Y))
(check! "overlay.loser-gets-cow-conflict" (and (string-contains? rbb "cow-conflict") (string-contains? rbb "write-write")) rbb)
;; 6.3 disjoint commits from 4 fibers all land
(define D0 0) (define D1 0) (define D2 0) (define D3 0)
(define dfs (map (lambda (k) (spawn-reporting res (str k) (lambda () (fiber:overlay-begin) (fiber:overlay-define (format "D~a" k) (+ 10 k))
                                                               (let ((c (fiber:overlay-commit))) (if (eq? c #t) "ok" (str c))))))
                 (range 4)))
(define douts (map (lambda (f) (channel:recv res)) dfs))
(for-each fiber:join dfs)
(check! "overlay.disjoint-commits" (and (all? (lambda (o) (equal? o "ok")) douts) (equal? (list D0 D1 D2 D3) (list 10 11 12 13))) (format "~a ~a" douts (list D0 D1 D2 D3)))
;; 6.4 #4757: after a commit, set! from inside a procedure body still writes the global
(define Z 0)
(define zf (spawn-reporting res "z" (lambda () (fiber:overlay-begin) (fiber:overlay-define "Z" 5) (str (fiber:overlay-commit)))))
(channel:recv res) (fiber:join zf)
(define (bump!) (set! Z (+ Z 1)) Z)
(bump!) (bump!)
(check! "overlay.set!-in-procedure-after-commit-4757" (= Z 7) (format "Z=~a (want 7)" Z))
;; 6.5 report counters are consistent
(define rep (fiber:overlay-report))
(info! "overlay.report" (format "~a" rep))
(define reps (str rep))
(check! "overlay.report-counts-exact" (and (string-contains? reps "begins=15") (string-contains? reps "commits=6") (string-contains? reps "conflicts=1") (string-contains? reps "rollbacks=8") (string-contains? reps "active=0"))
        (format "want begins=15 commits=6 conflicts=1 rollbacks=8 active=0, got ~a" reps))
;; bench: one swarm-style private evaluation cycle (begin/define/get/rollback), 2000x in a fiber
(define B 2000)
(define bf (spawn-reporting res "bench"
             (lambda () (let ((t (monotonic-ms)))
                          (for-each (lambda (i) (fiber:overlay-begin) (fiber:overlay-define "cand" i) (fiber:overlay-get "cand" #f) (fiber:overlay-rollback)) (range B))
                          (- (monotonic-ms) t)))))
(define bms (channel:recv res)) (fiber:join bf)
(bench! "overlay.private-eval-cycle-us" (if (number? bms) (r3 (/ (* 1000.0 bms) B)) bms) "us/cycle")
(emit "done" "ok")
