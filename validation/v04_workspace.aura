;; V4 EDSL workspace evolution loop (aura/evolve.aura): set-code/eval-current, query:calls,
;; (query :def-use), mutate:rebind with a reason, (query :mutation-log), ast:snapshot/ast:restore.
(define POL "(define (should-arbitrate? pct days) (and (> pct 0.2) (< days 14)))\n")
(define ENTRY "(define (decide pct days) (if (should-arbitrate? pct days) \"arbitrate\" \"absorb\"))\n")
(set-code (string-append POL ENTRY))
(eval-current)
(define (caller pct days) (decide pct days))      ; compiled before any rebind
(define (src) (str (current-source :workspace)))
(check! "ws.set-code+eval" (and (equal? (caller 0.3 5) "arbitrate") (equal? (caller 0.1 5) "absorb")) (format "~a ~a" (caller 0.3 5) (caller 0.1 5)))
;; 4.1 locate
(define calls (query:calls "should-arbitrate?"))
(define du (query :def-use "should-arbitrate?"))
(info! "ws.locate" (format "query:calls=~a def-use=~a" calls du))
(check! "ws.query-calls-finds-caller" (and (pair? calls) (= (length calls) 1)) (format "~a" calls))
;; 4.2 rebind with a Chinese reason; callers compiled earlier see v2; reason is in the log
(define S0 (ast:snapshot))
(define src0 (src))
(define log0 (let ((l (query :mutation-log 200))) (if (pair? l) (length l) 0)))
(define REASON "阈值从20%降到10%：二级供应商波动放大")
(define rb (mutate:rebind "should-arbitrate?" "(define (should-arbitrate? pct days) (and (> pct 0.1) (< days 14)))" REASON))
(eval-current)
(check! "ws.rebind-ok" (eq? rb #t) (format "~a" rb))
(check! "ws.rebind-visible-to-old-callers" (equal? (caller 0.15 5) "arbitrate") (format "caller(0.15)=~a" (caller 0.15 5)))
(define logs (str (query :mutation-log 200)))
(check! "ws.reason-in-mutation-log" (string-contains? logs REASON) (format "reason not found in ~a" (substring logs 0 (min 200 (string-length logs)))))
(check! "ws.source-reflects-rebind" (string-contains? (src) "0.1") (src))
;; 4.3 broken rebind (unbalanced) is rejected and the source is byte-identical
(define S1 (ast:snapshot))
(define src1 (src))
(define bad (try (mutate:rebind "should-arbitrate?" "(define (should-arbitrate? pct days) (and (> pct 0.2)" "broken patch") (catch (e) (list 'raised e))))
(check! "ws.broken-rebind-rejected" (not (eq? bad #t)) (format "~a" bad))
(check! "ws.broken-rebind-source-unchanged" (string=? (src) src1) "source changed by a rejected rebind")
(check! "ws.broken-rebind-behaviour-unchanged" (equal? (caller 0.15 5) "arbitrate") (caller 0.15 5))
;; 4.4 #4736: an unbalanced lambda passed to eval must raise, not return a procedure
(check! "ws.unbalanced-lambda-raises-4736" (err-of (lambda () (eval "(lambda (x) (+ x 1)"))) "eval of '(lambda (x) (+ x 1)' did not raise")
;; 4.5 restore: back to S0 byte-identical and behaviour v1
(define rr (ast:restore S0))
(eval-current)
(check! "ws.restore-byte-identical" (and (eq? rr #t) (string=? (src) src0)) (format "restore=~a" rr))
(check! "ws.restore-behaviour" (equal? (caller 0.15 5) "absorb") (caller 0.15 5))
;; restore forward to S1 (snapshots are not consumed)
(ast:restore S1) (eval-current)
(define fwd-src-ok (string=? (src) src1))
(define fwd-beh (caller 0.15 5))
(check! "ws.restore-forward" (and fwd-src-ok (equal? fwd-beh "arbitrate"))
        (format "after ast:restore S0 then ast:restore S1 (+eval-current): source-matches-S1=~a but caller(0.15)=~a (S1 code says arbitrate)" fwd-src-ok fwd-beh))
(ast:restore S0) (eval-current) (ast:restore S1) (eval-current)
(info! "ws.restore-forward-second-try" (caller 0.15 5))
(ast:restore S0) (eval-current)
;; 4.6 invalid snapshot id: no change
(define rbad (try (ast:restore 987654) (catch (e) (list 'raised e))))
(check! "ws.restore-invalid-id-no-change" (and (not (eq? rbad #t)) (string=? (src) src0)) (format "~a" rbad))
(info! "ws.restore-invalid-id-returns" rbad)
;; 4.7 200 evolve cycles (rebind -> snapshot -> restore): cost must stay flat (#4737), both
;; driven at top level and from inside a function (evolve.aura does the latter)
(define (cycle k)
  (mutate:rebind "should-arbitrate?" (format "(define (should-arbitrate? pct days) (and (> pct 0.~a) (< days 14)))" (+ 1 (modulo k 8))) "cycle")
  (let ((s (ast:snapshot))) (ast:restore S0) s))
(define (time-cycles n) (let ((t (monotonic-ms))) (for-each cycle (range n)) (- (monotonic-ms) t)))
(define c1 (time-cycles 50))
(define c2 (time-cycles 50))
(define c3 (time-cycles 50))
(define c4 (time-cycles 50))
(eval-current)
(info! "ws.cycle-ms-per-50" (list c1 c2 c3 c4))
(check! "ws.cycles-flat-4737" (< c4 (* 3 (max c1 20))) (format "50-cycle blocks took ~a ms" (list c1 c2 c3 c4)))
(check! "ws.after-200-cycles-restored" (and (string=? (src) src0) (equal? (caller 0.15 5) "absorb")) "state not restored")
(bench! "ws.rebind+snapshot+restore-ms" (r3 (/ (+ c1 c2 c3 c4) 200.0)) "ms/cycle")
;; 4.8 cost vs workspace size (10 / 100 / 400 defines)
(define (filler n) (apply string-append (map (lambda (i) (format "(define (f~a x) (+ x ~a))\n" i i)) (range n))))
(define (measure n)
  (set-code (string-append POL ENTRY (filler n)))
  (eval-current)
  (let* ((s (ast:snapshot))
         (t0 (monotonic-ms)) (_ (for-each (lambda (k) (mutate:rebind "should-arbitrate?" "(define (should-arbitrate? pct days) (> pct 0.3))" "size")) (range 10)))
         (t1 (monotonic-ms)) (_s (for-each (lambda (k) (ast:snapshot)) (range 10)))
         (t2 (monotonic-ms)) (_r (for-each (lambda (k) (ast:restore s)) (range 10)))
         (t3 (monotonic-ms)))
    (bench! (format "ws.rebind-ms@~a-defines" n) (/ (- t1 t0) 10.0) "ms")
    (bench! (format "ws.snapshot-ms@~a-defines" n) (/ (- t2 t1) 10.0) "ms")
    (bench! (format "ws.restore-ms@~a-defines" n) (/ (- t3 t2) 10.0) "ms")))
(for-each measure (list 10 100 400))
(emit "done" "ok")
