;; V2 structured concurrency (orch:scope-spawn / orch:scope-join-all / orch:scope-cancel-all)
;; as aura/agents.aura (one scoped risk analysis per impacted node) and aura/supervisor.aura
;; (pre-staged execution steps, cancel on human reject) use it.
(define BB (hash))
(define (bb! k v) (hash-set! BB k v))
(define (bb k) (hg BB k #f))
;; 2.1 exactly-once: 50 rounds x 16 scope tasks, every body runs once before join-all returns
(define ROUNDS 50) (define W 16)
(define CNT (atomic:counter 0))
(define bad-rounds 0) (define join-not-ok 0)
(define t0 (monotonic-ms))
(for-each (lambda (r)
  (for-each (lambda (i) (orch:scope-spawn (format "r~a/t~a" r i)
                          (lambda () (atomic:add! CNT 1) (bb! (format "r~a:~a" r i) (* i i)))))
            (range W))
  (let ((j (orch:scope-join-all :timeout-ms 10000)))
    (if (hg j "ok" #f) #t (set! join-not-ok (+ join-not-ok 1)))
    (if (all? (lambda (i) (equal? (bb (format "r~a:~a" r i)) (* i i))) (range W)) #t (set! bad-rounds (+ bad-rounds 1)))))
  (range ROUNDS))
(define t1 (monotonic-ms))
(check! "scope.exactly-once-50x16" (and (= bad-rounds 0) (= join-not-ok 0) (= (atomic:counter-value CNT) (* ROUNDS W)))
        (format "bad-rounds=~a join-not-ok=~a bodies-run=~a/~a" bad-rounds join-not-ok (atomic:counter-value CNT) (* ROUNDS W)))
(bench! "scope.spawn+join-us-per-task" (r3 (/ (* 1000.0 (- t1 t0)) (* ROUNDS W))) "us/task")
;; 2.2 scope tasks still run after an orch:run-workflow and an orch:supervise-batch in the same
;; process (#4725/#4726 regression: they used to be skipped)
(orch:run-workflow (vector (hash "tasks" (vector (lambda () 1) (lambda () 2))) (hash "tasks" (vector (lambda () 3)))))
(for-each (lambda (i) (orch:scope-spawn (format "after-wf/~a" i) (lambda () (bb! (format "wf:~a" i) #t)))) (range 8))
(orch:scope-join-all :timeout-ms 10000)
(check! "scope.runs-after-run-workflow" (all? (lambda (i) (bb (format "wf:~a" i))) (range 8))
        (format "~a/8 bodies ran" (count-if (lambda (i) (bb (format "wf:~a" i))) (range 8))))
(orch:supervise-batch (vector (lambda () 1) (lambda () (error "x"))) (orch:compose-workflow 'collect-all :max-retries 0))
(for-each (lambda (i) (orch:scope-spawn (format "after-sb/~a" i) (lambda () (bb! (format "sb:~a" i) #t)))) (range 8))
(orch:scope-join-all :timeout-ms 10000)
(check! "scope.runs-after-supervise-batch" (all? (lambda (i) (bb (format "sb:~a" i))) (range 8))
        (format "~a/8 bodies ran" (count-if (lambda (i) (bb (format "sb:~a" i))) (range 8))))
;; 2.3 a scope body that raises must be visible to the joiner (agents.aura audits status only)
(orch:scope-spawn "fail/bad" (lambda () (error "risk model crashed")))
(orch:scope-spawn "fail/good" (lambda () (bb! "fail:good" #t)))
(define jf (orch:scope-join-all :timeout-ms 10000))
(info! "scope.join-report-with-failed-body" (format "ok=~a status=~a join-fail-action-taken=~a on-join-fail-effective=~a"
       (hg jf "ok" "?") (hg jf "status" "?") (hg jf "join-fail-action-taken" "?") (hg jf "on-join-fail-effective" "?")))
(define fail-keys (filter (lambda (k) (or (string-contains? k "fail") (string-contains? k "err"))) (map str (hash-keys jf))))
(check! "scope.failed-body-visible-in-join"
        (or (not (hg jf "ok" #t)) (not (equal? (hg jf "status" "ok") "ok")))
        (format "a body raised but join-all says ok=~a status=~a; failure-ish keys: ~a" (hg jf "ok" "?") (hg jf "status" "?") fail-keys))
;; 2.4 join-all :timeout-ms is a bound: bodies that wait on a flag that is not set yet
(define FLAG "pending")
(for-each (lambda (i) (orch:scope-spawn (format "slow/~a" i)
                        (lambda () (let wait ((k 0)) (if (or (not (equal? FLAG "pending")) (> k 2000000)) (bb! (format "slow:~a" i) FLAG) (begin (fiber:yield) (wait (+ k 1))))))))
          (range 4))
(define tj (monotonic-ms))
(define jt (orch:scope-join-all :timeout-ms 300))
(define jt-ms (- (monotonic-ms) tj))
(info! "scope.join-timeout-report" (format "ms=~a ok=~a status=~a reclaimed-count=~a cleanup-pending-count=~a bodies-started-before-timeout=~a/4" jt-ms (hg jt "ok" "?") (hg jt "status" "?") (hg jt "reclaimed-count" "?") (hg jt "cleanup-pending-count" "?") (count-if (lambda (i) (bb (format "slow:~a" i))) (range 4))))
(check! "scope.join-timeout-bounded" (< jt-ms 5000) (format "join-all :timeout-ms 300 took ~a ms" jt-ms))
(set! FLAG "approved")
(define jt2 (orch:scope-join-all :timeout-ms 10000))
(info! "scope.after-release" (format "ok=~a bodies-finished=~a/4" (hg jt2 "ok" "?") (count-if (lambda (i) (bb (format "slow:~a" i))) (range 4))))
;; 2.5 cancel-all on pre-staged steps (supervisor reject path); cancel is cooperative, so
;; bodies also watch a flag. Nothing may hang and no step may report "done".
(define DEC "pending")
(for-each (lambda (i) (orch:scope-spawn (format "exec/~a" i)
                        (lambda () (let wait ((k 0))
                                     (cond ((equal? DEC "approved") (bb! (format "exec:~a" i) "done"))
                                           ((or (equal? DEC "rejected") (> k 200000)) (bb! (format "exec:~a" i) "aborted"))
                                           (else (fiber:yield) (wait (+ k 1))))))))
          (range 6))
(define tc (monotonic-ms))
(define cr (orch:scope-cancel-all))
(set! DEC "rejected")
(define jc (orch:scope-join-all :timeout-ms 10000))
(define tc-ms (- (monotonic-ms) tc))
(define ex (map (lambda (i) (bb (format "exec:~a" i))) (range 6)))
(info! "scope.cancel-all" (format "cancel=~a join-status=~a ms=~a step-states=~a" (hg cr "status" (str cr)) (hg jc "status" "?") tc-ms ex))
(check! "scope.cancel-no-done-no-hang" (and (< tc-ms 10000) (= (count-if (lambda (x) (equal? x "done")) ex) 0)) (format "states=~a ms=~a" ex tc-ms))
;; 2.6 join-all without a scope is a loud error, not a silent ok
(check! "scope.join-without-scope-raises" (err-of (lambda () (orch:scope-join-all :timeout-ms 100))) "no error")
;; bench: join-all latency for a single trivial task (10 samples)
(define (one-round n) (let ((t (monotonic-ms))) (for-each (lambda (i) (orch:scope-spawn (format "q~a" i) (lambda () i))) (range n)) (orch:scope-join-all :timeout-ms 5000) (- (monotonic-ms) t)))
(define lat (map (lambda (x) (one-round 1)) (range 10)))
(info! "scope.join-latency-samples-ms" lat)
(bench! "scope.join-latency-1task-median-ms" (list-ref (list-sort < lat) 5) "ms")
(emit "done" "ok")
