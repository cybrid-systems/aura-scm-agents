;; ast:snapshot / ast:restore+eval-current cost per cycle: grows linearly when the loop runs inside a called function
;; (snapshot-growth-nested.aura) and stays flat in a top-level named let (snapshot-growth-toplevel.aura). 200 cycles.
(set-code "(define (f0 x) (if (> x 0) (+ x 0) (* x 2)))
(define (f1 x) (if (> x 1) (+ x 1) (* x 2)))
(define (f2 x) (if (> x 2) (+ x 2) (* x 2)))
(define (f3 x) (if (> x 3) (+ x 3) (* x 2)))
(define (f4 x) (if (> x 4) (+ x 4) (* x 2)))
(define (f5 x) (if (> x 5) (+ x 5) (* x 2)))
(define (f6 x) (if (> x 6) (+ x 6) (* x 2)))
(define (f7 x) (if (> x 7) (+ x 7) (* x 2)))
(define (f8 x) (if (> x 8) (+ x 8) (* x 2)))
(define (f9 x) (if (> x 9) (+ x 9) (* x 2)))
(define (f10 x) (if (> x 10) (+ x 10) (* x 2)))
(define (f11 x) (if (> x 11) (+ x 11) (* x 2)))
(define (f12 x) (if (> x 12) (+ x 12) (* x 2)))
(define (f13 x) (if (> x 13) (+ x 13) (* x 2)))
(define (f14 x) (if (> x 14) (+ x 14) (* x 2)))
(define (f15 x) (if (> x 15) (+ x 15) (* x 2)))
(define (f16 x) (if (> x 16) (+ x 16) (* x 2)))
(define (f17 x) (if (> x 17) (+ x 17) (* x 2)))
(define (f18 x) (if (> x 18) (+ x 18) (* x 2)))
(define (f19 x) (if (> x 19) (+ x 19) (* x 2)))")
(eval-current)
(define (ms) (monotonic-ms))
(define (cycle k)
  (let* ((t0 (ms)) (s (ast:snapshot)) (t1 (ms))
         (_r (mutate:rebind "f3" "(define (f3 x) (+ x 33))" "probe")) (_e (eval-current)) (t2 (ms))
         (_x (ast:restore s)) (_y (eval-current)) (t3 (ms)))
    (display (list k 'snap (- t1 t0) 'rebind+ec (- t2 t1) 'restore+ec (- t3 t2) (f3 10))) (newline)))
(let loop ((k 0)) (if (< k 200) (begin (cycle k) (loop (+ k 1))) #f))
