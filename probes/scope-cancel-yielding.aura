;; Repro: orch:scope-cancel-all reports cancelled-count=2 but bodies that keep calling fiber:yield are not
;; stopped; the next orch:scope-join-all :timeout-ms 3000 returns status=timeout after ~5000 ms.
(define (hg h k) (try (hash-ref h k) (catch (e) "-")))
(define (dumpk tag h ks) (display tag) (display ": ") (for-each (lambda (k) (display k) (display "=") (display (hg h k)) (display " ")) ks) (newline))
(define BB (hash))
(define rw (orch:run-workflow (vector (hash "tasks" (vector (lambda () (hash-set! BB "a" 1) 1) (lambda () (hash-set! BB "b" 2) 2))) (hash "tasks" (vector (lambda () (hash-set! BB "c" (+ (hash-ref BB "a") (hash-ref BB "b"))) 3))))))
(dumpk "rw" rw (list "ok" "stages-ok" "stages-failed"))
(display (list (hash-ref BB "a") (hash-ref BB "c")))(newline)
(orch:scope-spawn "risk-P1" (lambda () (hash-set! BB "P1" 11) 11))
(orch:scope-spawn "risk-P2" (lambda () (hash-set! BB "P2" 22) 22))
(define d (orch:agent-directory)) (dumpk "dir" d (list "count" "name-table-count")) (display (hash-ref d "agents"))(newline)
(define ja (orch:scope-join-all :timeout-ms 3000)) (dumpk "join-all" ja (list "ok" "status" "joined-count"))
(display (list (hg BB "P1") (hg BB "P2")))(newline)
(orch:scope-spawn "exec-1" (lambda () (begin (spin 100000000) (hash-set! BB "exec1" 'ran) 1)))
(orch:scope-spawn "exec-2" (lambda () (begin (spin 100000000) (hash-set! BB "exec2" 'ran) 1)))
(define (spin n) (if (> n 0) (begin (fiber:yield) (spin (- n 1))) (quote done)))
(define t0 (monotonic-ms))
(define ca (orch:scope-cancel-all)) (dumpk "cancel" ca (list "ok" "cancelled-count"))
(define ja2 (orch:scope-join-all :timeout-ms 3000)) (dumpk "join-all2" ja2 (list "ok" "status" "cancelled" "joined-count"))
(display (list "ms" (- (monotonic-ms) t0) (hg BB "exec1")))(newline)
