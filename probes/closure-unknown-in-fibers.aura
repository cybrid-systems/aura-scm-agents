(define (change-pct e) (hash-ref e "pct"))
(define (frozen-horizon? e) (hash-ref e "frozen"))
(define f (eval "(lambda (edi-change inventory-exposure) (and (> (abs (change-pct edi-change)) 0.3083) (> inventory-exposure 1209732) (not (frozen-horizon? edi-change)) (>= (hash-ref edi-change \"confidence\") 0.4479)))"))
(define (all-ok? pred rows) (if (null? rows) #t (if (pred (car rows)) (all-ok? pred (cdr rows)) #f)))
(define (smoke f) (all-ok? (lambda (e) (boolean? (f e (hash-ref e "exposure")))) edi-history))
(define (bad-row f) (let loop ((rs edi-history)) (if (null? rs) "none" (let ((v (try (f (car rs) (hash-ref (car rs) "exposure")) (catch (e) (list 'err e))))) (if (boolean? v) (loop (cdr rs)) (format "~a=>~s" (hash-ref (car rs) "id") v))))))
(display (list 'serial (smoke f))) (newline)
(define (first-bad g rows) (if (null? rows) #t (let ((v (g (car rows)))) (if (boolean? v) (first-bad g (cdr rows)) (list (hash-ref (car rows) "id") v)))))
(define (smoke2 f) (first-bad (lambda (e) (f e (hash-ref e "exposure"))) edi-history))
(define (smoke3 f) (all-ok? (lambda (e) (let ((v (f e (hash-ref e "exposure")))) (if (boolean? v) #t (begin (display (list "BAD" (hash-ref e "id") v)) (newline) #f)))) edi-history))
(define CH (channel:create 64))
(define (direct f) (let loop ((rs edi-history)) (if (null? rs) #t (if (boolean? (f (car rs) (hash-ref (car rs) "exposure"))) (loop (cdr rs)) #f))))
(define (count-bad g n) (let loop ((i 0) (bad "")) (if (= i n) bad (loop (+ i 1) (let ((v (try (g f) (catch (e) (format "ERR:~a" e))))) (if (eq? v #t) bad (string-append bad (format "[~s]" v))))))))
(define (str1 x) x)
(define MODE "smoke")
(define (work k) (str1 (if (string=? MODE "smoke") (count-bad smoke3 400) (count-bad direct 400))))
(define fs (map (lambda (k) (fiber:spawn (lambda () (channel:send CH (work k)) k))) (iota 8)))
(display (list MODE (map (lambda (k) (channel:recv CH)) (iota 8)))) (newline)
