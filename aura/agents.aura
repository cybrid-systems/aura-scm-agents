;; The four specialist agents + supervisor. Agents are deterministic and rule-based;
;; every decision goes through an EDSL policy living in the Aura workspace.

(define HORIZON 7)   ; planning horizon (days) for shortfall / exposure
(define (node n) (hash-ref nodes n))
(define (nget n k) (hash-ref (node n) k))

;; ================================================================ 1. Demand & Arbitration
(define (demand-handler m)
  (let* ((case-id (hash-ref m "body"))
         (e (bb (string-append case-id ":edi")))
         (part (hash-ref e "part"))
         (delta (* (nget part "daily") (hash-ref e "pct")))
         (exposure (round (* (abs delta) 10 (nget part "cost"))))
         (arb (demand-decide e exposure))
         (hyp (cond ((and (> (hash-ref e "pct") 0) (high-confidence? e))
                     "customer pull-in confirmed by firm release (demand-side), not a forecast miss")
                    ((> (hash-ref e "pct") 0) "low-confidence increase: likely forecast bias / noisy release")
                    (else "demand drop: check OEM build-plan change"))))
    (bb! (string-append case-id ":demand")
         (hash "delta-daily" delta "exposure" exposure "arbitrate" arb "hypothesis" hyp))
    (audit! "demand" "explain" (format "~a part=~a pct=~a exposure=~a should-arbitrate?=~a" case-id part (hash-ref e "pct") exposure arb))
    ;; agent-to-agent: Demand triggers Risk with the arbitration signal
    (send! "risk" "demand" "trigger" 0 (string-append case-id ";" (if arb "arbitrate" "no-arbitrate")))
    (audit! "demand" "trigger-risk" case-id)
    (reply! m "demand" (format "arbitrate=~a;exposure=~a" arb exposure))))

;; ================================================================ 2. Risk & Response
;; Multi-hop impact over the BOM graph: extra daily demand flows parent -> child * qty.
;; Shared components cascade "up" to sibling parents (contention) at hop+1.
(define (children p) (foldl (lambda (acc e) (if (string=? (car e) p) (append acc (list e)) acc)) (list) bom))
(define (parents c) (foldl (lambda (acc e) (if (string=? (cadr e) c) (append acc (list (car e))) acc)) (list) bom))
(define (impact-walk part extra)
  ;; returns list of (node hop extra-daily via)
  (let walk ((frontier (list (list part 0 extra "edi"))) (acc (list)))
    (if (null? frontier) (reverse acc)
        (let* ((cur (car frontier)) (n (car cur)) (hop (cadr cur)) (x (caddr cur))
               (kids (map (lambda (e) (list (cadr e) (+ hop 1) (* x (caddr e)) n)) (children n))))
          (walk (append (cdr frontier) kids) (cons cur acc))))))
(define (cascade impacted)
  ;; sibling parents of impacted shared components that the EDI did not touch directly
  (let ((names (map car impacted)))
    (foldl (lambda (acc it)
             (foldl (lambda (acc2 p) (if (or (mem? p names) (lookup p acc2)) acc2
                                         (append acc2 (list (list p (+ (cadr it) 1) 0 (car it))))))
                    acc (parents (car it))))
           (list) impacted)))
(define (risk-level days) (cond ((< days 5) 'high) ((< days 10) 'medium) (else 'low)))
(define (shared-extra n impacted)
  ;; contention: a cascaded finished part loses cover on the shared component it depends on
  (foldl (lambda (acc it) (if (mem? n (parents (car it))) (+ acc (caddr it)) acc)) 0 impacted))

(define (proposal n action days shortfall)
  (let ((kind (car action)))
    (cond ((eq? kind 'alert-planner)
           (hash "node" n "action" "expedite-review" "detail" "alert planner: immediate expedite review (air freight)"
                 "cost" (round (* shortfall (nget n "cost") 0.6)) "supplier" (nget n "supplier")))
          ((eq? kind 'suggest-alternative-supplier)
           (hash "node" n "action" "alt-supplier" "detail" (string-append "qualify alternative supplier " (nget n "alt"))
                 "cost" 45000 "supplier" (nget n "alt")))
          ((and (eq? kind 'propose-internal-rebalance) (= shortfall 0))
           (hash "node" n "action" "monitor" "detail" "rebalance not needed (covered over horizon)" "cost" 0 "supplier" (nget n "supplier")))
          ((eq? kind 'propose-internal-rebalance)
           (hash "node" n "action" "rebalance" "detail" (format "transfer ~a units from sister plant" (min shortfall (hg sister-stock n 0)))
                 "cost" (round (* (min shortfall (hg sister-stock n 0)) 1.5)) "supplier" (nget n "supplier")))
          (else (hash "node" n "action" "monitor" "detail" "monitor coverage" "cost" 0 "supplier" (nget n "supplier"))))))

(define (cover-of n it x)
  (let* ((use (+ (nget n "daily") x)) (days (fmt2 (/ (* 1.0 (nget n "on-hand")) use)))
         (short (max 0 (round (- (* use HORIZON) (nget n "on-hand"))))))
    (hash "node" n "hop" (cadr it) "via" (car (cdddr it)) "extra" x "days" days "shortfall" short
          "level" (risk-level days))))

(define (risk-handler m)
  (let* ((parts (split-on (hash-ref m "body") ";"))
         (case-id (car parts)) (signal (cadr parts))
         (e (bb (string-append case-id ":edi")))
         (part (hash-ref e "part"))
         (extra (* (nget part "daily") (hash-ref e "pct")))
         (direct (impact-walk part extra))
         (casc (cascade direct))
         (impacted (append direct casc)))
    (audit! "risk" "recv-arbitration-signal" (format "~a signal=~a from=~a" case-id signal (hash-ref m "from")))
    (audit! "risk" "graph-impact" (format "~a hops=~a nodes=~a cascade=~a" case-id
                                          (foldl (lambda (a it) (max a (cadr it))) 0 impacted) (length impacted) (map car casc)))
    ;; one scoped analysis agent per impacted node (structured concurrency)
    (for-each (lambda (it)
                (let* ((n (car it)) (x (if (= (caddr it) 0) (shared-extra n direct) (caddr it))))
                  (orch:scope-spawn (string-append case-id "/risk:" n)
                    (lambda () (bb! (string-append case-id ":cover:" n) (cover-of n it x))))))
              impacted)
    (let ((j (orch:scope-join-all :timeout-ms 10000)))
      (audit! "risk" "scope-join-all" (format "~a status=~a spawned=~a" case-id (hash-ref j "status") (length impacted))))
    ;; a scope task that never ran is a runtime bug (aura#4725/#4726, fixed in 3162d79ff): it is
    ;; counted and audited, never recomputed inline, and the case reports it as missing.
    (for-each (lambda (it)
                (if (bb (string-append case-id ":cover:" (car it))) #t
                    (audit! "risk" "scope-task-missing" (format "~a ~a: scope body did not run" case-id (car it)))))
              impacted)
    (let* ((covers (map (lambda (it) (bb (string-append case-id ":cover:" (car it)))) impacted))
           (missing (count-if (lambda (c) (not c)) covers))
           (ranked (list-sort (lambda (a b) (< (hash-ref a "days") (hash-ref b "days"))) (keep (lambda (c) c) covers)))
           (plan (map (lambda (c) (let ((act (risk-respond (hash-ref c "level") (hash-ref c "days"))))
                                    (hash-set! c "policy-action" (str act))
                                    (proposal (hash-ref c "node") act (hash-ref c "days") (hash-ref c "shortfall"))))
                      ranked)))
      (bb! (string-append case-id ":risk") (hash "ranked" ranked "plan" plan "missing" missing "signal" signal))
      (for-each (lambda (p) (audit! "risk" "propose" (format "~a ~a ~a cost=~a" case-id (hash-ref p "node") (hash-ref p "action") (hash-ref p "cost")))) plan)
      (send! "supervisor" "risk" "risk-result" 0 (format "~a;nodes=~a;missing=~a" case-id (length ranked) missing)))))

;; ================================================================ 3. Profit Forensics
(define (forensics-handler m)
  (let* ((case-id (hash-ref m "body"))
         (key (string-append case-id ":leak:"))
         (pol (orch:compose-workflow 'collect-all :max-retries 0))
         (tasks (map (lambda (ev) (lambda () (bb! (string-append key (hash-ref ev "id"))
                                                   (hash "id" (hash-ref ev "id") "type" (hash-ref ev "type") "part" (hash-ref ev "part")
                                                         "cause" (hash-ref ev "cause") "leak" (- (hash-ref ev "premium") (hash-ref ev "claim"))))))
                     ops-history))
         ;; default watch-scope (aura#4723 fixed in e6f4169e0: waits for the batch, real ok/err counts)
         (sb (orch:supervise-batch tasks pol))
         (rows (keep (lambda (x) x) (map (lambda (ev) (bb (string-append key (hash-ref ev "id")))) ops-history)))
         (causes (foldl (lambda (acc r) (if (mem? (hash-ref r "cause") acc) acc (append acc (list (hash-ref r "cause"))))) (list) rows))
         (chains (map (lambda (c) (let ((rs (keep (lambda (r) (string=? (hash-ref r "cause") c)) rows)))
                                    (hash "cause" c "events" (map (lambda (r) (hash-ref r "id")) rs)
                                          "types" (foldl (lambda (a r) (if (mem? (hash-ref r "type") a) a (append a (list (hash-ref r "type"))))) (list) rs)
                                          "leak" (sum-by (lambda (r) (hash-ref r "leak")) rs))))
                      causes))
         (plan (hash-ref (bb (string-append case-id ":risk")) "plan"))
         (plan-cost (sum-by (lambda (p) (hash-ref p "cost")) plan)))
    (bb! (string-append case-id ":forensics")
         (hash "chains" (list-sort (lambda (a b) (> (hash-ref a "leak") (hash-ref b "leak"))) chains)
               "total-leak" (sum-by (lambda (c) (hash-ref c "leak")) chains)
               "batch-ok" (hash-ref sb "ok-count") "batch-err" (hash-ref sb "err-count") "batch-status" (hash-ref sb "status")
               "plan-cost" plan-cost))
    (audit! "forensics" "supervise-batch" (format "~a status=~a ok=~a err=~a (malformed record isolated, collect-all)"
                                                 case-id (hash-ref sb "status") (hash-ref sb "ok-count") (hash-ref sb "err-count")))
    (send! "claims" "forensics" "evidence" 0 case-id)
    (audit! "forensics" "evidence->claims" case-id)
    (reply! m "forensics" (format "chains=~a;leak=~a" (length chains) (sum-by (lambda (c) (hash-ref c "leak")) chains)))))

;; ================================================================ 4. Claims & Recovery
(define (classify-all claims) (map (lambda (c) (cons c (claims-classify c))) claims))
(define (claims-handler m)
  (let* ((case-id (hash-ref m "body"))
         (fx (bb (string-append case-id ":forensics")))
         (cls (classify-all claim-history))
         (n-sup (count-if (lambda (p) (eq? (cdr p) 'supplier-delay)) cls))
         (n-dem (count-if (lambda (p) (eq? (cdr p) 'demand-forecast-error)) cls))
         (n-unk (count-if (lambda (p) (eq? (cdr p) 'unknown)) cls))
         (recover (sum-by (lambda (p) (if (eq? (cdr p) 'supplier-delay) (hash-ref (car p) "amount") 0)) cls))
         (sup-chain (keep (lambda (c) (> (length (keep (lambda (x) #t) (hash-ref c "events"))) 0)) (hash-ref fx "chains")))
         (evid (sum-by (lambda (c) (if (string=? (hash-ref c "cause") "SUP-T2-C lead-time miss") (hash-ref c "leak") 0)) sup-chain))
         (rules (append
                 (if (>= n-sup 5) (list "PREVENT: hold 10-day safety stock on CST-7 while SUP-T2-C on-time-delivery < 90%; auto-raise lead-time-miss claim") (list))
                 (if (>= n-dem 5) (list "PREVENT: route EDI releases with forecast bias or market-signal mismatch to planner review before expediting") (list))
                 (if (> evid 0) (list (format "RECOVER: file supplier claim vs SUP-T2-C for unrecovered air-freight leakage ~a" evid)) (list)))))
    (bb! (string-append case-id ":claims")
         (hash "supplier-delay" n-sup "demand-forecast-error" n-dem "unknown" n-unk
               "recovery-opportunity" (+ recover evid) "rules" rules))
    (audit! "claims" "classify" (format "~a supplier-delay=~a demand-forecast-error=~a unknown=~a recovery=~a" case-id n-sup n-dem n-unk (+ recover evid)))
    (send! "supervisor" "claims" "claims-result" 0 case-id)))
