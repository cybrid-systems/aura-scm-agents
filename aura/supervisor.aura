;; ================================================================ 5. Orchestrator / Supervisor
;; Dispatches tasks, resolves conflicts between agents, routes to human confirmation,
;; and emits the unified decision package + audit trail.

(define HUMAN-COST-LIMIT 100000)

(define (boot-agents!)
  (let ((s (orch:spawn-agent "supervisor" (lambda () 'idle) :attach-mailbox #t)))
    (audit! "supervisor" "spawn-agent" (format "supervisor id=~a" (hash-ref s "id"))))
  (register-agent! "demand" demand-handler)
  (register-agent! "risk" risk-handler)
  (register-agent! "forensics" forensics-handler)
  (register-agent! "claims" claims-handler))

(define (collect-supervisor-mail!) (pump!) (absorb-supervisor-mail!))

;; Conflict resolution between Risk's plan and Forensics' evidence.
(define (resolve-conflicts case-id)
  (let* ((risk (bb (string-append case-id ":risk")))
         (fx (bb (string-append case-id ":forensics")))
         (switch-leak (sum-by (lambda (c) (if (string=? (hash-ref c "cause") "unnecessary alt-supplier PPAP") (hash-ref c "leak") 0)) (hash-ref fx "chains")))
         (conflicts (list))
         (plan (map (lambda (p)
                      (let ((n (hash-ref p "node")))
                        (if (and (string=? (hash-ref p "action") "alt-supplier") (> switch-leak 0) (> (hg sister-stock n 0) 0)
                                 (> (hash-ref (bb (string-append case-id ":cover:" n)) "shortfall") 0))
                            (let* ((cover (bb (string-append case-id ":cover:" n)))
                                   (qty (min (hash-ref cover "shortfall") (hg sister-stock n 0)))
                                   (np (hash "node" n "action" "rebalance" "detail" (format "transfer ~a units from sister plant (supervisor override)" qty)
                                             "cost" (round (* qty 1.5)) "supplier" (hash-ref p "supplier"))))
                              (set! conflicts (append conflicts (list (format "~a: risk=alt-supplier vs forensics=switch-leakage ~a -> rebalance (cost ~a vs ~a)" n switch-leak (hash-ref np "cost") (hash-ref p "cost")))))
                              np)
                            p)))
                    (hash-ref risk "plan"))))
    (for-each (lambda (c) (audit! "supervisor" "resolve-conflict" c)) conflicts)
    (cons plan conflicts)))

;; Pre-staged execution steps wait (cooperatively) for the human decision. Approve -> they
;; complete via scope-join-all; reject -> orch:scope-cancel-all, and the bodies also see
;; the rejected flag (cancel is cooperative; see README).
(define (stage-execution! case-id plan)
  (for-each (lambda (p)
              (let ((n (hash-ref p "node")) (flag (string-append case-id ":decision")))
                (orch:scope-spawn (string-append case-id "/exec:" n)
                  (lambda ()
                    (let wait ((i 0))
                      (let ((d (bb flag)))
                        (cond ((equal? d "approved") (bb! (string-append case-id ":exec:" n) "done"))
                              ((or (equal? d "rejected") (> i 200000)) (bb! (string-append case-id ":exec:" n) "aborted"))
                              (else (fiber:yield) (wait (+ i 1))))))))))
            (keep (lambda (p) (not (string=? (hash-ref p "action") "monitor"))) plan)))

(define (run-case case-id edi human)
  (audit! "supervisor" "case-open" (format "~a ~a" case-id (hash-ref edi "signal")))
  (bb! (string-append case-id ":edi") edi)
  ;; stage 0: input validation as an orch workflow (two parallel checks, then a graph check)
  (let ((wf (orch:run-workflow
             (vector (hash "tasks" (vector (lambda () (bb! (string-append case-id ":chk:edi") (hash-has-key? nodes (hash-ref edi "part"))))
                                           (lambda () (bb! (string-append case-id ":chk:inv") (= (length (hash-keys nodes)) (length (hash-keys sister-stock)))))))
                     (hash "tasks" (vector (lambda () (bb! (string-append case-id ":chk:graph") (> (length bom) 0)))))))))
    (audit! "supervisor" "run-workflow" (format "~a validate stages-ok=~a ok=~a" case-id (hash-ref wf "stages-ok") (hash-ref wf "ok"))))
  ;; stage 1: Demand (it triggers Risk agent-to-agent inside the same pump)
  (let ((r (ask! "demand" "explain" case-id)))
    (audit! "supervisor" "demand-reply" r))
  (collect-supervisor-mail!)
  (if (not (hg SUP-INBOX (string-append "risk-result:" case-id) #f)) (error "risk did not report") #t)
  ;; stage 2: Forensics -> Claims evidence chain
  (let ((r (ask! "forensics" "analyze" case-id)))
    (audit! "supervisor" "forensics-reply" r))
  (collect-supervisor-mail!)
  (let* ((demand (bb (string-append case-id ":demand")))
         (risk (bb (string-append case-id ":risk")))
         (fx (bb (string-append case-id ":forensics")))
         (cl (bb (string-append case-id ":claims")))
         (rc (resolve-conflicts case-id))
         (plan (car rc)) (conflicts (cdr rc))
         (cost (sum-by (lambda (p) (hash-ref p "cost")) plan))
         (expedites (count-if (lambda (p) (string=? (hash-ref p "action") "expedite-review")) plan))
         (needs-human (or (hash-ref demand "arbitrate") (> expedites 0) (> cost HUMAN-COST-LIMIT)))
         (decision "auto-approved") (exec-done 0) (lost 0) (cancel-info "-"))
    (stage-execution! case-id plan)
    (if needs-human
        (begin
          (audit! "supervisor" "route-human" (format "~a arbitrate=~a expedites=~a cost=~a" case-id (hash-ref demand "arbitrate") expedites cost))
          (set! decision (if (equal? human "approve") "approved" "rejected"))
          (audit! "human" decision (format "~a (simulated planner)" case-id)))
        #t)
    (bb! (string-append case-id ":decision") (if (equal? decision "rejected") "rejected" "approved"))
    (if (equal? decision "rejected")
        (let ((c (orch:scope-cancel-all)))
          (set! cancel-info (format "cancelled-count=~a" (hash-ref c "cancelled-count")))
          (audit! "supervisor" "scope-cancel-all" (format "~a ~a" case-id cancel-info)))
        #t)
    (let ((j (orch:scope-join-all :timeout-ms 10000)))
      (audit! "supervisor" "scope-join-all" (format "~a status=~a" case-id (hash-ref j "status"))))
    ;; a staged task that never ran although join-all said ok is a runtime bug (aura#4725/#4726, fixed in
    ;; 3162d79ff): it is counted and audited, never executed inline.
    (for-each (lambda (p)
                (let ((k (string-append case-id ":exec:" (hash-ref p "node"))))
                  (if (or (bb k) (string=? (hash-ref p "action") "monitor")) #t
                      (begin
                        (set! lost (+ lost 1))
                        (audit! "supervisor" "scope-task-lost" (format "~a ~a: staged body never ran" case-id (hash-ref p "node")))))))
              plan)
    (set! exec-done (count-if (lambda (p) (equal? (bb (string-append case-id ":exec:" (hash-ref p "node"))) "done")) plan))
    ;; ------------------------------------------------ unified decision package
    (let ((P (string-append "pkg." case-id)))
      (emit (string-append P ".decision") decision)
      (emit (string-append P ".human-required") needs-human)
      (emit (string-append P ".arbitrate") (hash-ref demand "arbitrate"))
      (emit (string-append P ".exposure") (hash-ref demand "exposure"))
      (emit (string-append P ".hypothesis") (hash-ref demand "hypothesis"))
      (emit (string-append P ".impacted") (length (hash-ref risk "ranked")))
      (emit (string-append P ".max-hop") (foldl (lambda (a c) (max a (hash-ref c "hop"))) 0 (hash-ref risk "ranked")))
      (for-each (lambda (c) (emit (string-append P ".priority")
                                  (format "~a|hop=~a|via=~a|days=~a|shortfall=~a|level=~a|policy=~a"
                                          (hash-ref c "node") (hash-ref c "hop") (hash-ref c "via") (hash-ref c "days")
                                          (hash-ref c "shortfall") (hash-ref c "level") (hash-ref c "policy-action"))))
                (hash-ref risk "ranked"))
      (for-each (lambda (p) (emit (string-append P ".action")
                                  (format "~a|~a|~a|cost=~a" (hash-ref p "node") (hash-ref p "action") (hash-ref p "detail") (hash-ref p "cost"))))
                plan)
      (for-each (lambda (c) (emit (string-append P ".conflict") c)) conflicts)
      (emit (string-append P ".plan-cost") cost)
      (emit (string-append P ".expedites") expedites)
      (for-each (lambda (c) (emit (string-append P ".leak-chain")
                                  (format "~a|~a|~a|leak=~a" (hash-ref c "cause") (hash-ref c "types") (hash-ref c "events") (hash-ref c "leak"))))
                (hash-ref fx "chains"))
      (emit (string-append P ".total-leak") (hash-ref fx "total-leak"))
      (emit (string-append P ".forensics-batch") (format "status=~a ok=~a err=~a" (hash-ref fx "batch-status") (hash-ref fx "batch-ok") (hash-ref fx "batch-err")))
      (emit (string-append P ".claims") (format "supplier-delay=~a demand-forecast-error=~a unknown=~a" (hash-ref cl "supplier-delay") (hash-ref cl "demand-forecast-error") (hash-ref cl "unknown")))
      (emit (string-append P ".recovery-opportunity") (hash-ref cl "recovery-opportunity"))
      (for-each (lambda (r) (emit (string-append P ".rule") r)) (hash-ref cl "rules"))
      (emit (string-append P ".exec-done") exec-done)
      (emit (string-append P ".exec-lost") lost)
      (emit (string-append P ".risk-missing") (hash-ref risk "missing"))
      (emit (string-append P ".exec-state") (map (lambda (p) (format "~a=~a" (hash-ref p "node") (bb (string-append case-id ":exec:" (hash-ref p "node"))))) plan))
      (emit (string-append P ".cancel") cancel-info)
      (emit (string-append P ".messages") MSG-COUNT)
      (emit (string-append P ".turns") TURNS)
      decision)))
