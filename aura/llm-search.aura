;; LLM-proposed structural edits + swarm local search around them ("LLM + swarm").
;;
;; Loaded after aura/search.aura and build/llm-proposals.aura (generated by scripts/llm_search.py,
;; which defines LLM-PROPS: (model seed policy k reason source)).  Flow per policy and model:
;;   1. LLM-only arm: the K proposals go through the SAME coordinator path as every swarm
;;      candidate (compile on the coordinator, per-fiber COW overlay, smoke
;;      type/shape gate on every train row, scoring on the TRAIN rows, rollback, one channel
;;      message).  Best gate-passing proposal by train fitness = the LLM-only result.
;;   2. LLM+swarm arm: the LLM-only winner (v1 if none passed) is parsed into an s-expression
;;      tree; every numeric literal becomes a PSO dimension and every and/or operand, cond
;;      clause and action/label leaf becomes an ACO decision.  Stages aco,pso,aco with the
;;      same budgets as the swarm-only search.  The coordinator still owns all shared state.
;;   3. Every arm (v1, hand v2, swarm-only, LLM-only, LLM+swarm) is reported on the HOLD-OUT
;;      rows, which are never used for selection.
;; Own token-preserving s-expression reader/printer: atoms stay the literal source text, so knob
;; ids, number formatting and printed variants are byte-stable.  (Aura now has `read-from-string` /
;; `datum->string`, aura#4746, and `quote` keeps special forms, aura#4743; they are not needed here.)

;; ---------------------------------------------------------------- s-expression reader / printer
(define (ws-char? c) (or (char=? c #\space) (char=? c #\newline) (char=? c #\tab) (char=? c #\return)))
(define (delim? c) (or (ws-char? c) (char=? c #\() (char=? c #\)) (char=? c #\")))
(define (sx-tokens s)
  (let loop ((cs (string->list s)) (acc (list)))
    (cond ((null? cs) (reverse acc))
          ((ws-char? (car cs)) (loop (cdr cs) acc))
          ((char=? (car cs) #\;) (loop (let skip ((r cs)) (if (or (null? r) (char=? (car r) #\newline)) r (skip (cdr r)))) acc))
          ((char=? (car cs) #\() (loop (cdr cs) (cons "(" acc)))
          ((char=? (car cs) #\)) (loop (cdr cs) (cons ")" acc)))
          ((char=? (car cs) #\') (loop (cdr cs) (cons "'" acc)))
          ((char=? (car cs) #\")
           (let sl ((r (cdr cs)) (b (list #\")))
             (cond ((null? r) (loop r (cons (list->string (reverse b)) acc)))
                   ((char=? (car r) #\\) (if (null? (cdr r)) (sl (cdr r) b) (sl (cddr r) (cons (cadr r) (cons #\\ b)))))
                   ((char=? (car r) #\") (loop (cdr r) (cons (list->string (reverse (cons #\" b))) acc)))
                   (else (sl (cdr r) (cons (car r) b))))))
          (else (let al ((r cs) (b (list)))
                  (if (or (null? r) (delim? (car r))) (loop r (cons (list->string (reverse b)) acc))
                      (al (cdr r) (cons (car r) b))))))))
;; tokens -> (node . rest); atoms are strings, lists are lists; 'x -> ("quote" x)
(define (sx-read toks)
  (cond ((null? toks) (error "sx: unexpected end"))
        ((string=? (car toks) "(")
         (let loop ((r (cdr toks)) (acc (list)))
           (cond ((null? r) (error "sx: missing )"))
                 ((string=? (car r) ")") (cons (reverse acc) (cdr r)))
                 (else (let ((x (sx-read r))) (loop (cdr x) (cons (car x) acc)))))))
        ((string=? (car toks) ")") (error "sx: unexpected )"))
        ((string=? (car toks) "'") (let ((x (sx-read (cdr toks)))) (cons (list "quote" (car x)) (cdr x))))
        (else (cons (car toks) (cdr toks)))))
(define (sx-parse s) (let ((r (sx-read (sx-tokens s)))) (if (null? (cdr r)) (car r) (error "sx: trailing tokens"))))
(define (sx->str n) (if (string? n) n (string-append "(" (join-with " " (map sx->str n)) ")")))
(define (num-tok? t) (and (string? t) (> (string-length t) 0) (not (char=? (string-ref-char t 0) #\")) (number? (string->number t))))
(define (string-ref-char s i) (list-ref (string->list s) i))
(define (int-tok? t) (not (mem? "." (map (lambda (c) (list->string (list c))) (string->list t)))))

;; ---------------------------------------------------------------- knobs of an arbitrary policy tree
;; Pre-order walk with a counter.  The same walk is used to RECORD the knobs (extraction) and
;; to GENERATE a variant (substitution), so ids line up; dropped subtrees are still walked.
(define ACT-VOCAB
  (list (list "expedite-response"
              (list (list "alert" "(list (quote alert-planner) (quote immediate-expedite-review))")
                    (list "alt" "(list (quote suggest-alternative-supplier))")
                    (list "rebalance" "(list (quote propose-internal-rebalance))")
                    (list "monitor" "(list (quote monitor))")))
        (list "claim-root-cause"
              (list (list "supplier-delay" "(quote supplier-delay)") (list "demand-forecast-error" "(quote demand-forecast-error)")
                    (list "unknown" "(quote unknown)")))
        (list "should-arbitrate?" (list))))
(define (vocab-of pol) (cadr (assoc pol ACT-VOCAB)))
(define (vocab-name vocab s) (let loop ((v vocab)) (cond ((null? v) #f) ((string=? (cadr (car v)) s) (car (car v))) (else (loop (cdr v))))))
(define (vocab-src vocab name) (cadr (assoc name vocab)))
(define HELPER-NAMES (list "change-pct" "frozen-horizon?" "high-confidence?" "edi-increase?" "supplier-lead-time-miss?" "forecast-bias?"
                           "bias-amount" "market-signal-mismatch?" "risk-rank"))
(define KW-CTR 0) (define KW-MODE "record") (define KW-VOCAB (list))
(define KW-NUMS (list)) (define KW-DECS (list))     ; record: (id value int?) / (id kind current-option)
(define KW-NUMV (hash)) (define KW-CHV (hash))     ; generate: id -> value / option
(define KW-NZ-DONE #f)
(define (kw-tick!) (set! KW-CTR (+ KW-CTR 1)) KW-CTR)
(define (kw-fmt v int?) (if int? (number->string (inexact->exact (round v))) (number->string (r4 v))))
(define (kw-num! t)
  (let ((k (kw-tick!)))
    (if (string=? KW-MODE "record") (begin (set! KW-NUMS (append KW-NUMS (list (list k (string->number t) (int-tok? t))))) t)
        (let ((s (if (hash-has-key? KW-NUMV k) (kw-fmt (hash-ref KW-NUMV k) (int-tok? t)) t)))
          (if (and (string=? NOISE "type") (not KW-NZ-DONE)) (begin (set! KW-NZ-DONE #t) (string-append "\"" s "\"")) s)))))
(define (kw-atom! t)
  (cond ((num-tok? t) (kw-num! t))
        ((and (string=? KW-MODE "gen") (string=? NOISE "unbound") (not KW-NZ-DONE) (mem? t HELPER-NAMES))
         (set! KW-NZ-DONE #t) (string-append t "-typo"))
        (else t)))
(define (kw-dec! kind cur)   ; -> chosen option for this decision id
  (let ((k (kw-tick!)))
    (if (string=? KW-MODE "record") (begin (set! KW-DECS (append KW-DECS (list (list k kind cur)))) cur)
        (hg KW-CHV k cur))))
(define (kw-leaf! node)      ; action/label leaf: maybe replaced from the vocabulary
  (let ((nm (vocab-name KW-VOCAB (sx->str node))))
    (if (not nm) (kw-walk node)
        (let ((o (kw-dec! "act" nm))) (sx-parse (vocab-src KW-VOCAB o))))))
(define (kw-walk n)
  (cond ((string? n) (kw-atom! n))
        ((null? n) n)
        ((and (string? (car n)) (string=? (car n) "quote")) n)
        ((and (string? (car n)) (or (string=? (car n) "and") (string=? (car n) "or")) (>= (length n) 3))
         (let* ((ops (map (lambda (o) (let* ((d (kw-dec! "op" "keep")) (w (kw-walk o))) (list d w))) (cdr n)))
                (kept (map cadr (keep (lambda (x) (string=? (car x) "keep")) ops))))
           (if (null? kept) (if (string=? (car n) "and") "#t" "#f") (cons (car n) kept))))
        ((and (string? (car n)) (string=? (car n) "cond"))
         (let* ((cls (map (lambda (c)
                            (if (and (pair? c) (string? (car c)) (string=? (car c) "else"))
                                (list "keep" (list "else" (kw-leaf! (cadr c))))
                                (let* ((d (kw-dec! "cl" "keep"))
                                       (test (kw-walk (car c)))
                                       (body (map (lambda (b) (kw-leaf! b)) (cdr c))))
                                  (list d (cons test body)))))
                          (cdr n)))
                (kept (map cadr (keep (lambda (x) (string=? (car x) "keep")) cls))))
           (if (null? kept) "#f" (cons "cond" kept))))
        ((and (string? (car n)) (string=? (car n) "if") (= (length n) 4))
         (list "if" (kw-walk (cadr n)) (kw-leaf! (caddr n)) (kw-leaf! (nth n 3))))
        (else (map kw-walk n))))
;; (define (NAME args) BODY) -> body walk only
(define (kw-run! mode tree vocab numv chv)
  (set! KW-CTR 0) (set! KW-MODE mode) (set! KW-VOCAB vocab) (set! KW-NUMV numv) (set! KW-CHV chv) (set! KW-NZ-DONE #f)
  (if (string=? mode "record") (begin (set! KW-NUMS (list)) (set! KW-DECS (list))) #f)
  (let* ((body (kw-walk (caddr tree)))
         (body2 (if (and (string=? mode "gen") (string=? NOISE "shape")) (list "if" body "(quote yes)" "(quote no)") body)))
    (sx->str (list "define" (cadr tree) body2))))
(define MAX-PSO-DIMS 6)
(define (num-bounds v) (cond ((and (>= v 0) (<= v 1)) (list 0.0 1.0)) ((> v 1) (list (* v 0.25) (* v 2.5))) (else (list (* v 2.5) (* v 0.25)))))
(define (dec-options kind cur vocab) (if (string=? kind "act") (cons cur (keep (lambda (o) (not (string=? o cur))) (map car vocab))) (list "keep" "drop")))

;; build a synthetic policy spec around a source: (name gen mf mw smoke fit obj mnames bounds v1c v1s v2c v2s decisions)
(define EXTRA-POLICIES (list))
(define (policy-by-name n)
  (let loop ((ps (append POLICIES EXTRA-POLICIES)))
    (cond ((null? ps) (error (string-append "unknown policy key " n))) ((string=? (p-name (car ps)) n) (car ps)) (else (loop (cdr ps))))))
(define (synthetic-policy! key base src)
  (let* ((tree (sx-parse src)) (vocab (vocab-of (p-name base)))
         (_ (kw-run! "record" tree vocab (hash) (hash)))
         (nums (take-n KW-NUMS MAX-PSO-DIMS)) (decs KW-DECS)
         (gen (lambda (cont choices)
                (let ((nv (hash)) (cv (hash)))
                  (for-each (lambda (n v) (hash-set! nv (car n) v)) nums cont)
                  (for-each (lambda (d o) (hash-set! cv (car d) o)) decs choices)
                  (kw-run! "gen" tree vocab nv cv))))
         (spec (list key gen (p-mf base) (p-mw base) (p-smoke base) (p-fit base) (p-obj base) (p-mnames base)
                     (map (lambda (n) (num-bounds (cadr n))) nums) (map cadr nums) (map caddr decs)
                     (map cadr nums) (map caddr decs)
                     (map (lambda (d) (list (string-append (cadr d) (number->string (car d))) (dec-options (cadr d) (caddr d) vocab))) decs))))
    (set! EXTRA-POLICIES (append EXTRA-POLICIES (list spec)))
    spec))
(define (wrap-policy! key base)   ; same functions, own key (own BEST / FRONT / counters)
  (let ((spec (cons key (cdr base)))) (set! EXTRA-POLICIES (append EXTRA-POLICIES (list spec))) spec))

;; raw-source candidate (LLM proposal): registered like any other attempt
(define (new-src-cand! key stage src)
  (set! NEXT-ID (+ NEXT-ID 1))
  (hash-set! CANDS NEXT-ID (list key stage (list) (list) "none" src))
  NEXT-ID)

;; ---------------------------------------------------------------- hold-out scoring (coordinator, never used for selection)
(define (holdout-of base src)
  (let ((cc (compile-candidate src)))
    (if (not (string=? (car cc) "ok")) (list "reject" (list) -1000.0)
        (try (let ((m (mf-holdout (p-name base) (nth cc 1)))) (list "ok" m ((p-fit base) m)))
             (catch (e) (list "runtime" (list) -1000.0))))))
;; guards of the arm's result (coordinator; train rows + synthetic grid)
(define (guards-of-src base src)
  (let ((cc (compile-candidate src)))
    (if (not (string=? (car cc) "ok")) (list "reject" "-")
        (let ((gf (guards-fail (p-name base) (nth cc 1))))
          (list (if gf (string-append "fail:" gf) "pass") (guards-detail (p-name base) (nth cc 1)))))))
;; second, harder claims hold-out (distribution shift: small forecast biases, lead-time misses
;; without an EDI increase, noisy EDI increases); reported only, never used for selection
(define (holdout-hard-of base src)
  (if (not (string=? (p-name base) "claim-root-cause")) #f
      (let ((cc (compile-candidate src)))
        (if (not (string=? (car cc) "ok")) (list (list) -1000.0)
            (try (let ((m (mf-claims-on (nth cc 1) claim-holdout-hard))) (list m ((p-fit base) m)))
                 (catch (e) (list (list) -1000.0)))))))
(define (train-of base src)   ; coordinator re-score on train (serial; used to cross-check fiber results)
  (let ((cc (compile-candidate src)))
    (if (not (string=? (car cc) "ok")) (list "reject" (list) -1000.0)
        (try (let ((m ((p-mf base) (nth cc 1)))) (list "ok" m ((p-fit base) m))) (catch (e) (list "runtime" (list) -1000.0))))))

(define ARM-ROWS (list))   ; (arm policy key best-id)
(define (one-line s) (list->string (map (lambda (c) (if (char=? c #\newline) #\space c)) (string->list s))))
(define (emit-arm! arm base key id extra)
  (let* ((pol (p-name base)) (src (if id (nth (hash-ref CANDS id) 5) (policy-src pol "v1")))
         (tr (train-of base src)) (ho (holdout-of base src)) (tag (string-append "arm." arm "." pol)))
    (set! ARM-ROWS (append ARM-ROWS (list (list arm pol key id))))
    (emit (string-append tag ".id") (if id id "v1-fallback"))
    (emit (string-append tag ".train-fit") (r4 (nth tr 2)))
    (emit (string-append tag ".train") (join-with ";" (nth tr 1)))
    (emit (string-append tag ".holdout-fit") (r4 (nth ho 2)))
    (emit (string-append tag ".holdout") (join-with ";" (nth ho 1)))
    (emit (string-append tag ".gap") (r4 (- (nth tr 2) (nth ho 2))))
    (let ((gg (guards-of-src base src)) (hh (holdout-hard-of base src)))
      (emit (string-append tag ".guards") (car gg))
      (emit (string-append tag ".guard-violations") (cadr gg))
      (if hh (begin (emit (string-append tag ".holdout-hard-fit") (r4 (cadr hh)))
                    (emit (string-append tag ".holdout-hard") (join-with ";" (car hh)))) #f))
    (emit (string-append tag ".evals") (hg PEVALS key 0))
    (emit (string-append tag ".rejects") (hg KREJ key 0))
    (emit (string-append tag ".src") (one-line src))   ; @@key=value lines: no raw newlines
    (for-each (lambda (kv) (emit (string-append tag "." (car kv)) (cadr kv))) extra)))

;; ---------------------------------------------------------------- the arms
(define (run-stages! p start-cont start-choices)
  (for-each
    (lambda (st)
      (let* ((has (hash-has-key? BEST (p-name p)))
             (b (if has (hash-ref CANDS (nth (hash-ref BEST (p-name p)) 1)) #f))
             (cont (if has (nth b 2) start-cont)) (choices (if has (nth b 3) start-choices)))
        (cond ((string=? st "pso") (if (null? (p-bounds p)) #f (pso-stage-with! p "pso" choices PSO-GENS)))
              (else (if (null? (p-dec p)) #f (aco-stage! p cont))))
        (emit (string-append "search." (p-name p) ".stage")
              (format "~a fit=~a id=~a" st (if has (r4 (car (hash-ref BEST (p-name p)))) "-") (if has (nth (hash-ref BEST (p-name p)) 1) "-")))))
    STAGES))
(define (props-for model pol) (keep (lambda (r) (and (string=? (nth r 0) model) (string=? (nth r 2) pol))) LLM-PROPS))
(define LLM-BASE (hash))   ; "model/pol" -> (base-id reason k)
(define (llm-arms! model base)
  (let* ((pol (p-name base)) (k1 (string-append pol "@" model)) (k2 (string-append pol "@" model "+swarm"))
         (props (props-for model pol)) (p1 (wrap-policy! k1 base))
         (ids (map (lambda (r) (new-src-cand! k1 (string-append "llm:" model ":k" (number->string (nth r 3))) (nth r 5))) props))
         (_ (run-batch ids))
         (passed (count-if (lambda (id) (> (hg SRC-CACHE (nth (hash-ref CANDS id) 5) -1000.0) -999.0)) ids))
         (b1 (if (hash-has-key? BEST k1) (nth (hash-ref BEST k1) 1) #f))
         (reason (if b1 (nth (nth props (index-of b1 ids)) 4) "no proposal passed the gate: swarm starts from v1"))
         (start-src (if b1 (nth (hash-ref CANDS b1) 5) (policy-src pol "v1")))
         ;; own reader: an LLM source it cannot parse falls back to v1 as the swarm start
         (p2 (try (synthetic-policy! k2 base start-src) (catch (e) (synthetic-policy! k2 base (policy-src pol "v1")))))
         ;; the start point is attempt #1 of the swarm key (same gate / fiber path)
         (bid (new-cand! p2 "base" (p-v1c p2) (p-v1s p2) "none"))
         (_2 (run-batch (list bid)))
         (first-id (+ NEXT-ID 1)))
    (hash-set! LLM-BASE (string-append model "/" pol) (list b1 reason bid))
    (run-stages! p2 (p-v1c p2) (p-v1s p2))
    (emit-arm! (string-append "llm:" model) base k1 b1
               (list (list "proposals" (length ids)) (list "gate-pass" passed) (list "reason" (clean-err reason))))
    (emit-arm! (string-append "llm+swarm:" model) base k2 (if (hash-has-key? BEST k2) (nth (hash-ref BEST k2) 1) #f)
               (list (list "base-id" bid) (list "attempts" (format "~a-~a" first-id NEXT-ID))
                     (list "pso-dims" (length (p-bounds p2))) (list "aco-decisions" (length (p-dec p2)))))))

(define (run-llm-search)
  (run-search)                                    ; swarm-only arm (template search, as before)
  (for-each (lambda (p)
              (let ((pol (p-name p)))
                (emit-arm! "v1" p pol (cand-of-stage pol "v1") (list))
                (emit-arm! "v2" p pol (cand-of-stage pol "v2") (list))
                (emit-arm! "swarm" p pol (nth (hash-ref BEST pol) 1) (list))))
            POLICIES)
  (for-each (lambda (model) (for-each (lambda (p) (llm-arms! model p)) POLICIES)) LLM-MODELS)
  (emit "llm.evals-total" EVALS)
  (emit "llm.flakes" FLAKES)
  (emit "llm.rejects" (format "parse=~a type=~a runtime=~a guard=~a" (hash-ref REJECTS "parse") (hash-ref REJECTS "type") (hash-ref REJECTS "runtime") (hash-ref REJECTS "guard")))
  (emit "llm.guard-rejects" (join-with ";" (map (lambda (k) (format "~a=~a" k (hash-ref GUARD-REJ k))) (list-sort string<? (hash-keys GUARD-REJ)))))
  #t)
(define (cand-of-stage pol stage)
  (let loop ((i 1)) (cond ((> i NEXT-ID) #f) ((let ((c (hash-ref CANDS i))) (and (string=? (nth c 0) pol) (string=? (nth c 1) stage))) i) (else (loop (+ i 1))))))

;; ---------------------------------------------------------------- single-writer commits (top-level forms, #4737)
;; Each LLM+swarm winner is committed with mutate:rebind; the reason carries the LLM's reason
;; and the swarm provenance (base attempt, best attempt, attempt id range).  Gate vs the
;; workspace state before the commit; fiber metrics must equal workspace metrics.
(define S-V1 #f)
(define (llm-snapshot-v1!) (set! S-V1 (ast:snapshot)) (emit "llmcommit.snapshot" S-V1))
(define (llm-commit! model i tag)
  (let* ((base (nth POLICIES i)) (pol (p-name base)) (k2 (string-append pol "@" model "+swarm"))
         (lb (hash-ref LLM-BASE (string-append model "/" pol)))
         (best (hash-ref BEST k2)) (id (nth best 1)) (src (nth (hash-ref CANDS id) 5))
         (reason (format "LLM ~a: ~a | swarm aco,pso,aco: llm-proposal #~a -> base #~a -> best #~a (~a evals, train fit ~a)"
                         model (clean-err (nth lb 1)) (if (nth lb 0) (nth lb 0) "none") (nth lb 2) id (hg PEVALS k2 0) (r4 (car best))))
         (s0 (ast:snapshot)) (m0 ((p-mw base)))
         (rb (try (mutate:rebind pol src reason) (catch (e) (list 'rebind-error e))))
         (_e (eval-current)) (m1 ((p-mw base)))
         (gfail (ws-guards-fail pol))
         (gate (and (not gfail)
                    (cond ((string=? pol "should-arbitrate?") (g-arbitration (m-hash base m0) (m-hash base m1)))
                          ((string=? pol "claim-root-cause") (g-claims (m-hash base m0) (m-hash base m1)))
                          (else (g-expedite (m-hash base m0) (m-hash base m1))))))
         (t (string-append "llmcommit." tag "." model "." pol)))
    (if gate #f (begin (ast:restore s0) (eval-current)))
    (emit (string-append t ".rebind") (if (eq? rb #t) "ok" (str rb)))
    (emit (string-append t ".gate") (if gate "pass" "fail(restored)"))
    (emit (string-append t ".guards") (if gfail (string-append "fail:" gfail) "pass"))
    (emit (string-append t ".before") (join-with ";" m0))
    (emit (string-append t ".after") (join-with ";" m1))
    (emit (string-append t ".fiber-metrics-equal") (equal? m1 (nth best 2)))
    (emit (string-append t ".best-id") id)
    (emit (string-append t ".reason") reason)
    (audit! (string-append "llm+swarm:" model) "mutate:rebind"
            (format "~a ~a reason=~a gate=~a guards=~a(~a) before={~a} after={~a}" tag pol reason (if gate "pass" "fail") (if gfail (string-append "fail:" gfail) "pass") (guards-version) (join-with ";" m0) (join-with ";" m1)))
    gate))
(define (llm-restore-v1! model)
  (let ((src-a (current-source :workspace)))
    (ast:restore S-V1) (eval-current)
    (let ((ok (and (equal? (mw-arb) (tmpl-metrics "should-arbitrate?")) (equal? (mw-claims) (tmpl-metrics "claim-root-cause"))
                   (equal? (mw-exp) (tmpl-metrics "expedite-response")))))
      (emit (string-append "llmcommit.restore." model) (if ok "v1-metrics-restored" "MISMATCH"))
      (audit! "supervisor" "ast:restore" (format "undo trial commits of ~a -> v1 snapshot ~a restored=~a" model S-V1 ok)))))
(define (tmpl-metrics pol) (let ((c (cand-of-stage pol "v1"))) (nth (train-of (policy-by-name pol) (nth (hash-ref CANDS c) 5)) 1)))
;; final keep: per policy the LLM+swarm model with the best TRAIN fitness
(define (best-model-for i)
  (let* ((pol (p-name (nth POLICIES i))))
    (foldl (lambda (acc m) (if (or (not acc) (> (car (hash-ref BEST (string-append pol "@" m "+swarm"))) (car (hash-ref BEST (string-append pol "@" acc "+swarm"))))) m acc))
           #f LLM-MODELS)))
(define (llm-commit-best! i) (llm-commit! (best-model-for i) i "keep"))

;; ---------------------------------------------------------------- prompt context (SCM_MODE=context)
(define (ctx-policy! p)
  (let* ((pol (p-name p)) (src (policy-src pol "v1")) (f (nth (compile-candidate src) 1)) (m ((p-mf p) f)) (n 0))
    (emit (string-append "ctx." pol ".src") (clean-err src))
    (emit (string-append "ctx." pol ".metrics") (join-with ";" (map (lambda (k v) (format "~a=~a" k v)) (p-mnames p) m)))
    (emit (string-append "ctx." pol ".fitness") (r4 ((p-fit p) m)))
    (cond ((string=? pol "should-arbitrate?")
           (for-each (lambda (e) (let ((d (f e (hash-ref e "exposure"))))
                                   (if (not (eq? d (hash-ref e "needed")))
                                       (emit "ctx.should-arbitrate?.fail" (format "pct=~a exposure=~a frozen=~a confidence=~a needed=~a v1-decision=~a"
                                                                                  (hash-ref e "pct") (hash-ref e "exposure") (hash-ref e "frozen") (hash-ref e "confidence") (hash-ref e "needed") d)) #f)))
                     edi-history))
          ((string=? pol "claim-root-cause")
           (for-each (lambda (c) (let ((d (f c)))
                                   (if (not (eq? d (hash-ref c "truth")))
                                       (emit "ctx.claim-root-cause.fail" (format "edi-increase=~a lead-time-miss=~a forecast-bias=~a bias-amount=~a market-mismatch=~a amount=~a truth=~a v1=~a"
                                                                               (hash-ref c "edi-increase") (hash-ref c "lead-time-miss") (hash-ref c "forecast-bias") (hash-ref c "bias-amount") (hash-ref c "market-mismatch") (hash-ref c "amount") (hash-ref c "truth") d)) #f)))
                     claim-history))
          (else
           (for-each (lambda (r) (let* ((a (car (f (hash-ref r "level") (hash-ref r "days"))))
                                        (one (exp-cost-rows (lambda (l d) (list a)) (list r))))
                                   (if (or (> (nth one 3) 0) (>= (nth one 4) 45000))
                                       (emit "ctx.expedite-response.fail" (format "level=~a inventory-days=~a v1-action=~a cost=~a stockout=~a | outcome: risk-materialized=~a regular-lead=~a transfer-days=~a alt-supplier-lead=~a sister-stock=~a"
                                                                                (hash-ref r "level") (hash-ref r "days") a (nth one 4) (nth one 3) (hash-ref r "hits") (hash-ref r "lead") (hash-ref r "transfer") (hash-ref r "alt-lead") (hash-ref r "rebalance-ok"))) #f)))
                     risk-history)))))
;; ---------------------------------------------------------------- guard audit of given sources
;; (guard-audit! label policy src): business gate vs v1 on TRAIN + every domain guard, as the
;; commit path would see it (used to re-check earlier run results against guards.v1)
(define (guard-audit! label pol src)
  (let* ((base (policy-by-name pol)) (gg (guards-of-src base src)) (tr (train-of base src))
         (v1 (train-of base (policy-src pol "v1")))
         (biz (cond ((null? (nth tr 1)) #f)
                    ((string=? pol "should-arbitrate?") (g-arbitration (m-hash base (nth v1 1)) (m-hash base (nth tr 1))))
                    ((string=? pol "claim-root-cause") (g-claims (m-hash base (nth v1 1)) (m-hash base (nth tr 1))))
                    (else (g-expedite (m-hash base (nth v1 1)) (m-hash base (nth tr 1)))))))
    (emit (string-append "audit." label) (format "policy=~a business-gate=~a guards=~a violations=~a train-fit=~a"
                                                 pol (if biz "pass" "fail") (car gg) (cadr gg) (r4 (nth tr 2))))))
